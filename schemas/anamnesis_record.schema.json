{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "clinicalbridge/anamnesis_record",
  "title": "Anamnesis Record",
  "description": "Patient-reported information gathered by interview/check-in. EVERYTHING here is self-report unless stated otherwise. FICTIONAL DATA ONLY.",
  "type": "object",
  "required": ["source", "symptoms", "medication_adherence", "lifestyle", "family_history", "patient_concerns"],
  "properties": {
    "source": {
      "type": "object",
      "description": "Provenance of this anamnesis. May indicate it was not collected.",
      "properties": {
        "collected_date": { "type": ["string", "null"] },
        "method": { "type": "string" },
        "all_items_patient_reported": { "type": "boolean" },
        "note": { "type": "string" }
      }
    },
    "symptoms": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "symptom", "reported_by"],
        "properties": {
          "id": { "type": "string", "pattern": "^ANAMNESIS\\.symptom\\." },
          "symptom": { "type": "string", "description": "Plain symptom, NOT a diagnosis." },
          "onset": { "type": "string" },
          "severity": { "type": "string" },
          "duration": { "type": "string" },
          "context": { "type": "string" },
          "reported_by": { "type": "string", "enum": ["patient", "caregiver"] }
        }
      }
    },
    "history": {
      "type": ["object", "null"],
      "properties": {
        "id": { "type": "string" },
        "narrative": { "type": "string" },
        "reported_by": { "type": "string" }
      }
    },
    "medication_adherence": {
      "type": ["object", "null"],
      "properties": {
        "id": { "type": "string" },
        "status": { "type": "string", "description": "e.g. good | lapse | partial/conflicting | unknown" },
        "detail": { "type": "string" },
        "barriers": { "type": "string" },
        "reported_by": { "type": "string" }
      }
    },
    "lifestyle": {
      "type": ["object", "null"],
      "properties": {
        "id": { "type": "string" },
        "diet": { "type": "string" },
        "exercise": { "type": "string" },
        "smoking": { "type": "string" },
        "alcohol": { "type": "string" },
        "caffeine": { "type": "string" },
        "sleep": { "type": "string" },
        "reported_by": { "type": "string" }
      }
    },
    "family_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "relation": { "type": "string" },
          "condition": { "type": "string" },
          "reported_by": { "type": "string" }
        }
      }
    },
    "patient_concerns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "concern": { "type": "string", "description": "Preserve the patient's own words where possible." },
          "reported_by": { "type": "string" }
        }
      }
    }
  }
}
